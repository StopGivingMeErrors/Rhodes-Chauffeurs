# Copy to `.env` for local Vite. Do not commit `.env`.
# Names only — no values belong in git.

# Browser app (Vite). Required for auth, bookings, and the fleet catalog.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Declared in src/vite-env.d.ts. The current client does not read this key;
# card checkout is implemented on the server and is switched off in the UI.
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase Edge Function secrets. Set these in the Supabase dashboard, not in Vite.
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# RESEND_API_KEY
# RESEND_FROM
# BOOKING_EMAIL_WEBHOOK_SECRET
# ADMIN_NOTIFY_EMAILS
# ACCESS_CONTROL_ALLOW_ORIGIN
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
