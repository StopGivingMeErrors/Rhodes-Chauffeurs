# =============================================================================
# Velox VIP — environment checklist
# Copy to `.env` (Vite) and configure Supabase Edge Function secrets separately.
# =============================================================================

# --- Vite (public; prefixed VITE_) -------------------------------------------
# Supabase project URL, e.g. https://xxxx.supabase.co (or paste the project ref: xxxx)
VITE_SUPABASE_URL=

# Supabase public client key (browser) — Project Settings → API:
#   • Prefer "Publishable" under API keys (starts with sb_publishable_) — NOT "Secret" / sb_secret_*.
#   • Or legacy "anon" "public" JWT (starts with eyJ...).
# Never use the project ref alone, service_role, or sb_secret_* here.
#
# Email confirmation: Dashboard → Authentication → URL configuration must list your app origin
# (e.g. http://localhost:5173 and production URL) under Site URL and Redirect URLs so confirm links return here.
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key for card checkout in the browser
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Supabase Edge Functions (set in Dashboard → Edge Functions → Secrets) --
# Never expose these in Vite or commit them to client bundles.

# Stripe secret for Checkout + webhooks (used by create-checkout-session, stripe-webhook)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (used by stripe-webhook)
STRIPE_WEBHOOK_SECRET=

# Optional: fixed CORS origin for edge functions that echo Origin (create-checkout-session, send-email).
# If unset, they echo the request Origin when present, otherwise "*".
# ACCESS_CONTROL_ALLOW_ORIGIN=

# Resend API key — https://resend.com (free tier ~3k emails/month)
RESEND_API_KEY=

# Verified sender in Resend, e.g. "Velox VIP <bookings@yourdomain.com>"
RESEND_FROM=

# Shared secret for the send-email function (Database Webhooks must send this)
# Use a long random string (at least 24 characters). Send as: Authorization: Bearer <value>
# or header: x-webhook-secret: <value>
BOOKING_EMAIL_WEBHOOK_SECRET=

# Comma-separated ops inboxes notified when a guest creates a booking (also sends to profiles with role=admin)
ADMIN_NOTIFY_EMAILS=

# Supabase auto-injected in hosted Edge Functions (also available locally via supabase secrets)
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY
